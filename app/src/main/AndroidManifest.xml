<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <service
            android:name="com.govindtank.unlockcount.UnlockCounterWallpaper"
            android:enabled="true"
            android:exported="true"
            android:label="Classic"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_classic" />
        </service>

        <service
            android:name="com.govindtank.unlockcount.TimeFlowWallpaper"
            android:enabled="true"
            android:exported="true"
            android:label="Time Flow"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_time_flow" />
        </service>

        <service
            android:name="com.govindtank.unlockcount.ParticleWaveWallpaper"
            android:enabled="true"
            android:exported="true"
            android:label="Particle Wave"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_particle_wave" />
        </service>

        <service
            android:name="com.govindtank.unlockcount.GradientPulseWallpaper"
            android:enabled="true"
            android:exported="true"
            android:label="Gradient Pulse"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_gradient_pulse" />
        </service>

        <service
            android:name="com.govindtank.unlockcount.DataStreamWallpaper"
            android:enabled="true"
            android:exported="true"
            android:label="Data Stream"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_data_stream" />
        </service>

        <service
            android:name="com.govindtank.unlockcount.AuroraWallpaper"
            android:enabled="true"
            android:exported="true"
            android:label="Aurora"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_aurora" />
        </service>

        <service
            android:name="com.govindtank.unlockcount.MatrixRainWallpaper"
            android:enabled="true"
            android:exported="true"
            android:label="Matrix Rain"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_matrix_rain" />
        </service>

        <activity
            android:name="com.govindtank.unlockcount.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.govindtank.unlockcount.ui.settings.UnlockCountSettingsActivity"
            android:exported="false" />

        <activity
            android:name="com.govindtank.unlockcount.ui.settings.TimeFlowSettingsActivity"
            android:exported="false" />

        <activity
            android:name="com.govindtank.unlockcount.ui.settings.ParticleWaveSettingsActivity"
            android:exported="false" />

        <activity
            android:name="com.govindtank.unlockcount.ui.settings.GradientPulseSettingsActivity"
            android:exported="false" />

        <activity
            android:name="com.govindtank.unlockcount.ui.settings.DataStreamSettingsActivity"
            android:exported="false" />

        <activity
            android:name="com.govindtank.unlockcount.ui.settings.AuroraSettingsActivity"
            android:exported="false" />

        <activity
            android:name="com.govindtank.unlockcount.ui.settings.MatrixRainSettingsActivity"
            android:exported="false" />

    </application>

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

</manifest>
