<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <EditTextPreference
        android:key="name_reveal_name"
        android:title="Your Name"
        android:summary="Text to reveal with matrix effect"
        android:defaultValue="Govind" />
    <EditTextPreference
        android:key="name_reveal_matrix_color"
        android:title="Matrix Color"
        android:summary="Hex color, e.g. #00FF88"
        android:defaultValue="#00FF88" />
    <EditTextPreference
        android:key="name_reveal_text_color"
        android:title="Reveal Text Color"
        android:summary="Hex color, e.g. #FFFFFF"
        android:defaultValue="#FFFFFF" />
    <EditTextPreference
        android:key="name_reveal_font_size"
        android:title="Font Size"
        android:summary="Base font size in sp"
        android:defaultValue="24" />
    <EditTextPreference
        android:key="name_reveal_font_family"
        android:title="Font Family"
        android:summary="monospace, sans_serif, serif, or custom font name"
        android:defaultValue="monospace" />
    <EditTextPreference
        android:key="name_reveal_duration"
        android:title="Reveal Duration"
        android:summary="Duration in milliseconds"
        android:defaultValue="3000" />
    <EditTextPreference
        android:key="name_reveal_hold_duration"
        android:title="Hold Duration"
        android:summary="How long to show the revealed name before looping (ms)"
        android:defaultValue="30000" />
    <EditTextPreference
        android:key="name_reveal_column_spacing"
        android:title="Column Spacing"
        android:summary="Spacing between matrix columns"
        android:defaultValue="28" />
    <EditTextPreference
        android:key="name_reveal_char_spacing"
        android:title="Reveal Char Spacing"
        android:summary="Spacing between revealed characters"
        android:defaultValue="12" />
    <EditTextPreference
        android:key="name_reveal_decoy_speed"
        android:title="Decoy Speed"
        android:summary="Speed of random character cycling (ms)"
        android:defaultValue="50" />
    <SwitchPreferenceCompat
        android:key="pref_dark_mode"
        android:title="Dark Mode"
        android:defaultValue="true" />
</PreferenceScreen>
